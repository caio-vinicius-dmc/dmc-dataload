<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Não redirecionar se o arquivo ou diretório existe fisicamente na raiz
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Redirecionar todas as outras requisições para a pasta public/
    RewriteCond %{REQUEST_URI} !^/DMC-DATALOAD/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
